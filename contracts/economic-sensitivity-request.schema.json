{
  "$defs": {
    "EconomicAssumptions": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.7.0",
          "default": "0.7.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "modelTimeUnit": {
          "const": "minutes",
          "title": "Modeltimeunit",
          "type": "string"
        },
        "resourceProvisioning": {
          "items": {
            "$ref": "#/$defs/ResourceProvisioningAssumption"
          },
          "title": "Resourceprovisioning",
          "type": "array"
        },
        "stageVisit": {
          "items": {
            "$ref": "#/$defs/StageVisitAssumption"
          },
          "title": "Stagevisit",
          "type": "array"
        },
        "queueHolding": {
          "items": {
            "$ref": "#/$defs/HoldingCostAssumption"
          },
          "title": "Queueholding",
          "type": "array"
        },
        "wipHoldingCostPerItemTimeUnit": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number",
              "maximum": 1e+308
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wipholdingcostperitemtimeunit"
        },
        "costPerSlaViolation": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number",
              "maximum": 1e+308
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Costperslaviolation"
        },
        "costPerTerminalFailure": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number",
              "maximum": 1e+308
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Costperterminalfailure"
        },
        "rework": {
          "items": {
            "$ref": "#/$defs/ReworkCostAssumption"
          },
          "title": "Rework",
          "type": "array"
        },
        "costPerCompletedItem": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number",
              "maximum": 1e+308
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Costpercompleteditem"
        },
        "fixedCostPerAnalysisPeriod": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number",
              "maximum": 1e+308
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixedcostperanalysisperiod"
        },
        "allowPartialTotals": {
          "const": false,
          "default": false,
          "title": "Allowpartialtotals",
          "type": "boolean"
        }
      },
      "required": [
        "currency",
        "modelTimeUnit"
      ],
      "title": "EconomicAssumptions",
      "type": "object"
    },
    "ExponentialDistribution": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "exponential",
          "title": "Type",
          "type": "string"
        },
        "mean": {
          "exclusiveMinimum": 0,
          "title": "Mean",
          "type": "number",
          "maximum": 1e+308
        }
      },
      "required": [
        "type",
        "mean"
      ],
      "title": "ExponentialDistribution",
      "type": "object"
    },
    "FailureConfig": {
      "additionalProperties": false,
      "properties": {
        "probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability",
          "type": "number"
        },
        "routeId": {
          "minLength": 1,
          "title": "Routeid",
          "type": "string"
        },
        "maximumReworkAttempts": {
          "minimum": 0,
          "title": "Maximumreworkattempts",
          "type": "integer"
        }
      },
      "required": [
        "probability",
        "routeId",
        "maximumReworkAttempts"
      ],
      "title": "FailureConfig",
      "type": "object"
    },
    "FixedArrival": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "fixed",
          "title": "Type",
          "type": "string"
        },
        "interval": {
          "exclusiveMinimum": 0,
          "title": "Interval",
          "type": "number",
          "maximum": 1e+308
        }
      },
      "required": [
        "type",
        "interval"
      ],
      "title": "FixedArrival",
      "type": "object"
    },
    "FixedDistribution": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "fixed",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number",
          "maximum": 1e+308
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "FixedDistribution",
      "type": "object"
    },
    "HoldingCostAssumption": {
      "additionalProperties": false,
      "properties": {
        "stageId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stageid"
        },
        "costPerItemTimeUnit": {
          "minimum": 0,
          "title": "Costperitemtimeunit",
          "type": "number",
          "maximum": 1e+308
        }
      },
      "required": [
        "costPerItemTimeUnit"
      ],
      "title": "HoldingCostAssumption",
      "type": "object"
    },
    "ObservationConfig": {
      "additionalProperties": false,
      "properties": {
        "warmupDuration": {
          "default": 0,
          "minimum": 0,
          "title": "Warmupduration",
          "type": "number",
          "maximum": 1e+308
        },
        "measurementDuration": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number",
              "maximum": 1e+308
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurementduration"
        }
      },
      "title": "ObservationConfig",
      "type": "object"
    },
    "OperationalModel": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.2.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "timeUnit": {
          "const": "minutes",
          "title": "Timeunit",
          "type": "string"
        },
        "runConfig": {
          "$ref": "#/$defs/RunConfig"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceConfig"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "resourcePools": {
          "items": {
            "$ref": "#/$defs/ResourcePoolConfig"
          },
          "minItems": 1,
          "title": "Resourcepools",
          "type": "array"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/StageConfig"
          },
          "minItems": 1,
          "title": "Stages",
          "type": "array"
        },
        "routes": {
          "items": {
            "$ref": "#/$defs/RouteConfig"
          },
          "minItems": 1,
          "title": "Routes",
          "type": "array"
        },
        "slaRules": {
          "items": {
            "$ref": "#/$defs/SlaRule"
          },
          "minItems": 1,
          "title": "Slarules",
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "name",
        "timeUnit",
        "runConfig",
        "sources",
        "resourcePools",
        "stages",
        "routes",
        "slaRules"
      ],
      "title": "OperationalModel",
      "type": "object"
    },
    "PoissonArrival": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "poisson",
          "title": "Type",
          "type": "string"
        },
        "meanInterarrivalTime": {
          "exclusiveMinimum": 0,
          "title": "Meaninterarrivaltime",
          "type": "number",
          "maximum": 1e+308
        }
      },
      "required": [
        "type",
        "meanInterarrivalTime"
      ],
      "title": "PoissonArrival",
      "type": "object"
    },
    "ResourcePoolConfig": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "capacity": {
          "minimum": 1,
          "title": "Capacity",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "capacity"
      ],
      "title": "ResourcePoolConfig",
      "type": "object"
    },
    "ResourceProvisioningAssumption": {
      "additionalProperties": false,
      "properties": {
        "resourcePoolId": {
          "minLength": 1,
          "title": "Resourcepoolid",
          "type": "string"
        },
        "costPerCapacityTimeUnit": {
          "minimum": 0,
          "title": "Costpercapacitytimeunit",
          "type": "number",
          "maximum": 1e+308
        }
      },
      "required": [
        "resourcePoolId",
        "costPerCapacityTimeUnit"
      ],
      "title": "ResourceProvisioningAssumption",
      "type": "object"
    },
    "ReworkCostAssumption": {
      "additionalProperties": false,
      "properties": {
        "stageId": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stageid"
        },
        "costPerRework": {
          "minimum": 0,
          "title": "Costperrework",
          "type": "number",
          "maximum": 1e+308
        }
      },
      "required": [
        "costPerRework"
      ],
      "title": "ReworkCostAssumption",
      "type": "object"
    },
    "RiskThresholds": {
      "additionalProperties": false,
      "properties": {
        "minimumSlaAttainment": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimumslaattainment"
        },
        "maximumAverageCycleTime": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number",
              "maximum": 1e+308
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximumaveragecycletime"
        },
        "maximumP95CycleTime": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number",
              "maximum": 1e+308
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximump95Cycletime"
        },
        "maximumTimeWeightedQueueLength": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number",
              "maximum": 1e+308
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximumtimeweightedqueuelength"
        },
        "maximumTerminalFailureRate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number",
              "maximum": 1e+308
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximumterminalfailurerate"
        }
      },
      "title": "RiskThresholds",
      "type": "object"
    },
    "RouteConfig": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "success",
            "failure"
          ],
          "title": "Kind",
          "type": "string"
        },
        "fromStageId": {
          "minLength": 1,
          "title": "Fromstageid",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/RouteOption"
          },
          "minItems": 1,
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "fromStageId",
        "options"
      ],
      "title": "RouteConfig",
      "type": "object"
    },
    "RouteOption": {
      "additionalProperties": false,
      "properties": {
        "targetType": {
          "enum": [
            "stage",
            "completion"
          ],
          "title": "Targettype",
          "type": "string"
        },
        "targetId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Targetid"
        },
        "probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability",
          "type": "number"
        }
      },
      "required": [
        "targetType",
        "probability"
      ],
      "title": "RouteOption",
      "type": "object"
    },
    "RunConfig": {
      "additionalProperties": false,
      "properties": {
        "seed": {
          "anyOf": [
            {
              "maximum": 9223372036854776000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "title": "RunConfig",
      "type": "object"
    },
    "SensitivityExecutionConfig": {
      "additionalProperties": false,
      "properties": {
        "baseSeed": {
          "maximum": 9223372036854776000,
          "minimum": 0,
          "title": "Baseseed",
          "type": "integer"
        },
        "runCount": {
          "default": 50,
          "maximum": 100,
          "minimum": 2,
          "title": "Runcount",
          "type": "integer"
        },
        "confidenceLevel": {
          "default": 0.95,
          "title": "Confidencelevel",
          "type": "number",
          "minimum": -1e+308,
          "maximum": 1e+308
        },
        "minimumSuccessfulRunRatio": {
          "default": 1,
          "maximum": 1,
          "minimum": 0.5,
          "title": "Minimumsuccessfulrunratio",
          "type": "number"
        },
        "minimumPairedRunRatio": {
          "default": 1,
          "maximum": 1,
          "minimum": 0.5,
          "title": "Minimumpairedrunratio",
          "type": "number"
        },
        "observation": {
          "$ref": "#/$defs/ObservationConfig"
        }
      },
      "required": [
        "baseSeed"
      ],
      "title": "SensitivityExecutionConfig",
      "type": "object"
    },
    "SensitivityRequest": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "0.6.0",
          "default": "0.6.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "baselineModel": {
          "$ref": "#/$defs/OperationalModel"
        },
        "target": {
          "$ref": "#/$defs/SensitivityTarget"
        },
        "values": {
          "items": {
            "type": "number",
            "minimum": -1e+308,
            "maximum": 1e+308
          },
          "maxItems": 10,
          "minItems": 2,
          "title": "Values",
          "type": "array"
        },
        "execution": {
          "$ref": "#/$defs/SensitivityExecutionConfig"
        },
        "metrics": {
          "items": {
            "enum": [
              "slaAttainment",
              "completionRate",
              "flowEfficiency",
              "averageWaitingTime",
              "averageCycleTime",
              "p95CycleTime",
              "terminalFailureRate",
              "timeWeightedWip",
              "timeWeightedQueueLength",
              "totalReworkCount"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "thresholds": {
          "$ref": "#/$defs/RiskThresholds"
        }
      },
      "required": [
        "baselineModel",
        "target",
        "values",
        "execution",
        "metrics"
      ],
      "title": "SensitivityRequest",
      "type": "object"
    },
    "SensitivityTarget": {
      "additionalProperties": false,
      "properties": {
        "entityType": {
          "enum": [
            "resourcePool",
            "source",
            "stage",
            "route",
            "slaRule"
          ],
          "title": "Entitytype",
          "type": "string"
        },
        "entityId": {
          "minLength": 1,
          "title": "Entityid",
          "type": "string"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "entityType",
        "entityId",
        "field"
      ],
      "title": "SensitivityTarget",
      "type": "object"
    },
    "SlaRule": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "targetDuration": {
          "minimum": 0,
          "title": "Targetduration",
          "type": "number",
          "maximum": 1e+308
        },
        "sourceId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourceid"
        }
      },
      "required": [
        "id",
        "targetDuration"
      ],
      "title": "SlaRule",
      "type": "object"
    },
    "SourceConfig": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "itemCount": {
          "minimum": 1,
          "title": "Itemcount",
          "type": "integer"
        },
        "initialArrivalTime": {
          "minimum": 0,
          "title": "Initialarrivaltime",
          "type": "number",
          "maximum": 1e+308
        },
        "priority": {
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "firstStageId": {
          "minLength": 1,
          "title": "Firststageid",
          "type": "string"
        },
        "arrival": {
          "discriminator": {
            "mapping": {
              "fixed": "#/$defs/FixedArrival",
              "poisson": "#/$defs/PoissonArrival"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FixedArrival"
            },
            {
              "$ref": "#/$defs/PoissonArrival"
            }
          ],
          "title": "Arrival"
        }
      },
      "required": [
        "id",
        "name",
        "itemCount",
        "initialArrivalTime",
        "priority",
        "firstStageId",
        "arrival"
      ],
      "title": "SourceConfig",
      "type": "object"
    },
    "StageConfig": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "resourcePoolId": {
          "minLength": 1,
          "title": "Resourcepoolid",
          "type": "string"
        },
        "processingTime": {
          "discriminator": {
            "mapping": {
              "exponential": "#/$defs/ExponentialDistribution",
              "fixed": "#/$defs/FixedDistribution",
              "triangular": "#/$defs/TriangularDistribution",
              "uniform": "#/$defs/UniformDistribution"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FixedDistribution"
            },
            {
              "$ref": "#/$defs/ExponentialDistribution"
            },
            {
              "$ref": "#/$defs/UniformDistribution"
            },
            {
              "$ref": "#/$defs/TriangularDistribution"
            }
          ],
          "title": "Processingtime"
        },
        "queuePolicy": {
          "enum": [
            "fifo",
            "priority"
          ],
          "title": "Queuepolicy",
          "type": "string"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name",
        "resourcePoolId",
        "processingTime",
        "queuePolicy"
      ],
      "title": "StageConfig",
      "type": "object"
    },
    "StageVisitAssumption": {
      "additionalProperties": false,
      "properties": {
        "stageId": {
          "minLength": 1,
          "title": "Stageid",
          "type": "string"
        },
        "costPerVisit": {
          "minimum": 0,
          "title": "Costpervisit",
          "type": "number",
          "maximum": 1e+308
        }
      },
      "required": [
        "stageId",
        "costPerVisit"
      ],
      "title": "StageVisitAssumption",
      "type": "object"
    },
    "TriangularDistribution": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "triangular",
          "title": "Type",
          "type": "string"
        },
        "minimum": {
          "minimum": 0,
          "title": "Minimum",
          "type": "number",
          "maximum": 1e+308
        },
        "mode": {
          "minimum": 0,
          "title": "Mode",
          "type": "number",
          "maximum": 1e+308
        },
        "maximum": {
          "minimum": 0,
          "title": "Maximum",
          "type": "number",
          "maximum": 1e+308
        }
      },
      "required": [
        "type",
        "minimum",
        "mode",
        "maximum"
      ],
      "title": "TriangularDistribution",
      "type": "object"
    },
    "UniformDistribution": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "uniform",
          "title": "Type",
          "type": "string"
        },
        "minimum": {
          "minimum": 0,
          "title": "Minimum",
          "type": "number",
          "maximum": 1e+308
        },
        "maximum": {
          "minimum": 0,
          "title": "Maximum",
          "type": "number",
          "maximum": 1e+308
        }
      },
      "required": [
        "type",
        "minimum",
        "maximum"
      ],
      "title": "UniformDistribution",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.7.0",
      "default": "0.7.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "sensitivity": {
      "$ref": "#/$defs/SensitivityRequest"
    },
    "assumptions": {
      "$ref": "#/$defs/EconomicAssumptions"
    },
    "costMetrics": {
      "items": {
        "enum": [
          "recurringOperatingCost",
          "costPerCompletedItem",
          "resourceProvisioningCost",
          "queueHoldingCost",
          "slaViolationCost",
          "failureCost",
          "reworkCost"
        ],
        "type": "string"
      },
      "maxItems": 7,
      "minItems": 1,
      "title": "Costmetrics",
