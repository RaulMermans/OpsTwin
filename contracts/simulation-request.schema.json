{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opstwin.local/contracts/simulation-request.schema.json",
  "title": "OpsTwin simulation request 0.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "model"],
  "properties": {
    "schemaVersion": { "const": "0.3.0" },
    "runLabel": { "type": ["string", "null"], "minLength": 1 },
    "seedOverride": { "type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807 },
    "model": { "$ref": "operational-model.schema.json" },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warmupDuration": { "type": "number", "minimum": 0, "default": 0 },
        "measurementDuration": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "resultDetail": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "properties": { "mode": { "const": "summary" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "sampledItemLimit"],
          "properties": {
            "mode": { "const": "sampled" },
            "sampledItemLimit": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "properties": { "mode": { "const": "full" } }
        }
      ]
    }
  }
}
