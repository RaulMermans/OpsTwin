{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opstwin.local/contracts/sensitivity-request.schema.json",
  "title": "OpsTwin sensitivity request 0.6.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baselineModel", "target", "values", "execution", "metrics"],
  "properties": {
    "schemaVersion": { "const": "0.6.0" },
    "baselineModel": { "$ref": "https://opstwin.local/contracts/operational-model.schema.json" },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["entityType", "entityId", "field"],
      "properties": {
        "entityType": { "enum": ["resourcePool", "source", "stage", "route", "slaRule"] },
        "entityId": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 }
      }
    },
    "values": { "type": "array", "minItems": 2, "maxItems": 10, "uniqueItems": true, "items": { "type": "number" } },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["baseSeed"],
      "properties": {
        "baseSeed": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "runCount": { "type": "integer", "minimum": 2, "maximum": 100, "default": 50 },
        "confidenceLevel": { "enum": [0.9, 0.95, 0.99], "default": 0.95 },
        "minimumSuccessfulRunRatio": { "type": "number", "minimum": 0.5, "maximum": 1, "default": 1 },
        "minimumPairedRunRatio": { "type": "number", "minimum": 0.5, "maximum": 1, "default": 1 },
        "observation": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "warmupDuration": { "type": "number", "minimum": 0, "default": 0 },
            "measurementDuration": { "type": ["number", "null"], "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "metrics": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": { "enum": ["slaAttainment", "completionRate", "flowEfficiency", "averageWaitingTime", "averageCycleTime", "p95CycleTime", "terminalFailureRate", "timeWeightedWip", "timeWeightedQueueLength", "totalReworkCount"] }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "minimumSlaAttainment": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "maximumAverageCycleTime": { "type": ["number", "null"], "minimum": 0 },
        "maximumP95CycleTime": { "type": ["number", "null"], "minimum": 0 },
        "maximumTimeWeightedQueueLength": { "type": ["number", "null"], "minimum": 0 },
        "maximumTerminalFailureRate": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  }
}
