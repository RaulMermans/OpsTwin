{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "simulation": {
      "root": "apps/simulation-api",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/simulation/(.*)",
      "destination": { "service": "simulation" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
